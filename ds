        function app.clear() app.capture:clear();app.message=nil end
        function app.select(id) app.store:select(id);app.message=nil end
        function app.edit(text)
            if app.tab=="remotes" then
                local record=app.store:getSelected()
                if record then
                    if record.draft==nil then app.uiRevision+=1 end
                    record.draft=text
                end
            else app.drafts[app.tab]=text end
        end
        function app.setDraft(code)
            app.view.editor:ReleaseFocus()
            if app.tab=="remotes" then
                local record=app.store:getSelected()
                if record then record.draft=code end
            else app.drafts[app.tab]=code end
            app.draftVersions[app.tab]=(app.draftVersions[app.tab] or 0)+1
            app.view.editorKey=nil;app.view:update()
        end
        function app.setTab(tab)
            if app.tab==tab then return end
            app.view.editor:ReleaseFocus()
            app.tab=tab;app.view.editorKey=nil
            app.view.workbench:setTab(tab)
            app.view:update()
        end
        function app.notify(text,isError)
            app.message=text:lower();app.messageError=isError==true
            app.messageUntil=os.clock()+5
        end
        function app.copyCode(code)
            code=code or app.view.editor.Text
            local copied=pcall(setclipboard,code)
            app.notify(if copied then "Copied to clipboard" else "Clipboard unavailable",not copied)
            return copied
        end
        function app.restore()
            if app.tab~="remotes" then
                app.view.editor:ReleaseFocus()
                app.drafts[app.tab]="";app.view.editorKey=nil;app.view:update();return
            end
            local record=app.store:getSelected()
            if not record then return end
            app.view.editor:ReleaseFocus()
            record.draft=nil;record.generated=false;app.view.editorKey=nil
            record.frozen=false;record.freezeCode=nil
            app.view:update()
            app.notify("Original call restored")
        end
        function app.generateLoop()
            if app.tab~="remotes" then app.notify("pick a remote in the remotes tab",true);return end
            local record=app.store:getSelected()
            if not record then app.notify("Select a remote first",true);return end
            if record.generated then
                app.copyCode(app.view.editor.Text);return
            end
            local code=Generator.loop(app.view.editor.Text,record.name,
                "DarkSpyLoop_"..game.GameId.."_"..record.id)
            if #code>24000 then app.notify("Loop script exceeds editor limit",true);return end
            app.view.editor:ReleaseFocus()
            record.draft=code;record.generated=true;app.view.editorKey=nil
            app.view:update()
            local copied=app.copyCode(code)
            if copied then app.notify("Toggle + loop copied · starts OFF") end
        end
        function app.runCode(code)
            if app.running then
                if app.runThread then pcall(task.cancel,app.runThread) end
                app.runThread=nil;app.running=false;app.notify("Script stopped");return
            end
            local fn,compileError=loadstring(code or app.view.editor.Text,"DARK SPY Editor")
            if not fn then
                app.lastRunError=tostring(compileError)
                app.notify("Compile error · "..app.lastRunError,true);return false
            end
            app.running=true;app.notify("Running…")
            app.runThread=task.defer(function()
                local success,result=pcall(fn)
                app.running=false;app.runThread=nil
                if not app.alive then return end
                app.lastRunError=if success then nil else tostring(result)
                app.notify(if success then "Script finished" else "Runtime error · "..tostring(result),not success)
            end)
            return true
        end
        app.view=View.new(app,Serializer)
        app.view:update()
        worker=task.defer(function()
            while app.alive do
                task.wait(0.15)
                if not app.alive then break end
                app.capture:flush()
                if app.messageUntil and os.clock()>app.messageUntil then
                    app.message=nil;app.messageError=false;app.messageUntil=nil
                end
                local began=os.clock()
                local drawn=app.view:update()
                app.perf.ticks+=1
                if drawn then
                    app.perf.draws+=1;app.perf.lastUiMs=(os.clock()-began)*1000
                    app.perf.maxUiMs=math.max(app.perf.maxUiMs,app.perf.lastUiMs)
                else app.perf.skipped+=1 end
            end
        end)
    end)
    if not ok then app.stop(false);error(err,0) end
    getgenv().DarkSpy=app
    return {ready=true,name="dark spy",version="0.4"}
end
return Main

